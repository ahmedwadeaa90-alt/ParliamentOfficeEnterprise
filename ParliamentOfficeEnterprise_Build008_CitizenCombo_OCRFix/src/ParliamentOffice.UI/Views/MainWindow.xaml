<Window x:Class="ParliamentOffice.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="منظومة الإدارة البرلمانية الذكية" Height="780" Width="1220" WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" Background="#F3F4F6">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#111827" Padding="14">
            <DockPanel>
                <TextBlock Text="منظومة الإدارة البرلمانية الذكية - Build 008" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="UserText" Foreground="#D1D5DB" FontSize="14" HorizontalAlignment="Left"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" Margin="10" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="لوحة القيادة">
                <ScrollViewer>
                    <StackPanel Margin="12">
                        <WrapPanel>
                            <Border Style="{StaticResource Card}" Width="220"><StackPanel><TextBlock Text="الصادر" FontSize="16"/><TextBlock x:Name="OutgoingCount" FontSize="34" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="220"><StackPanel><TextBlock Text="الوارد" FontSize="16"/><TextBlock x:Name="IncomingCount" FontSize="34" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="220"><StackPanel><TextBlock Text="المواطنين" FontSize="16"/><TextBlock x:Name="CitizensCount" FontSize="34" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="220"><StackPanel><TextBlock Text="المتابعة" FontSize="16"/><TextBlock x:Name="FollowupCount" FontSize="34" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Width="220"><StackPanel><TextBlock Text="الجهات" FontSize="16"/><TextBlock x:Name="OrgsCount" FontSize="34" FontWeight="Bold"/></StackPanel></Border>
                        </WrapPanel>
                        <TextBlock Text="آخر الصادر" FontSize="18" FontWeight="Bold" Margin="8"/>
                        <DataGrid x:Name="LastOutgoingGrid" Height="150"/>
                        <TextBlock Text="آخر الوارد" FontSize="18" FontWeight="Bold" Margin="8"/>
                        <DataGrid x:Name="LastIncomingGrid" Height="150"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="الجهات">
                <DockPanel Margin="8">
                    <Border DockPanel.Dock="Top" Background="White" Padding="10" CornerRadius="10" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBlock Text="اسم الجهة" VerticalAlignment="Center" Margin="6"/>
                            <TextBox x:Name="OrgNameBox" Width="360"/>
                            <TextBlock Text="النوع" VerticalAlignment="Center" Margin="10,6,6,6"/>
                            <ComboBox x:Name="OrgTypeBox" Width="180" SelectedIndex="0"><ComboBoxItem Content="وزارة"/><ComboBoxItem Content="محافظة"/><ComboBoxItem Content="جهاز أمني"/><ComboBoxItem Content="هيئة"/><ComboBoxItem Content="دائرة"/><ComboBoxItem Content="جامعة"/><ComboBoxItem Content="أخرى"/></ComboBox>
                            <Button Content="إضافة جهة" Click="AddOrg_Click"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="OrganizationsGrid"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="الصادر">
                <DockPanel Margin="8">
                    <Border DockPanel.Dock="Top" Background="White" Padding="10" CornerRadius="10" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="رقم الصادر" VerticalAlignment="Center" Margin="6"/><TextBox x:Name="OutgoingNumberBox" Width="140"/><Button Content="رقم تلقائي" Click="GenerateOutgoingNumber_Click"/>
                                <TextBlock Text="تاريخ الصادر" VerticalAlignment="Center" Margin="10,6,6,6"/><DatePicker x:Name="OutgoingDatePicker" Width="150"/>
                                <TextBlock Text="الجهة" VerticalAlignment="Center" Margin="10,6,6,6"/><ComboBox x:Name="OutgoingOrgCombo" Width="280" DisplayMemberPath="Name" SelectedValuePath="Id" IsEditable="True" IsTextSearchEnabled="True"/>
                                <TextBlock Text="المواطن" VerticalAlignment="Center" Margin="10,6,6,6"/><ComboBox x:Name="OutgoingCitizenCombo" Width="300" DisplayMemberPath="FullName" SelectedValuePath="Id" TextSearch.TextPath="FullName" IsEditable="True" IsTextSearchEnabled="True" ToolTip="اختر المواطن من الأضبارة الرئيسية أو اكتب اسمه للبحث"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="الموضوع" VerticalAlignment="Center" Margin="6"/><TextBox x:Name="OutgoingSubjectBox" Width="520"/>
                                <TextBlock Text="مرتبط بوارد" VerticalAlignment="Center" Margin="10,6,6,6"/><ComboBox x:Name="OutgoingRelatedIncomingCombo" Width="360" DisplayMemberPath="Title" SelectedValuePath="Id"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="الأولوية" VerticalAlignment="Center" Margin="6"/><ComboBox x:Name="OutgoingPriorityBox" Width="120" SelectedIndex="0"><ComboBoxItem Content="عادي"/><ComboBoxItem Content="مهم"/><ComboBoxItem Content="عاجل"/></ComboBox>
                                <TextBlock Text="الحالة" VerticalAlignment="Center" Margin="10,6,6,6"/><ComboBox x:Name="OutgoingStatusBox" Width="150" SelectedIndex="0"><ComboBoxItem Content="جديد"/><ComboBoxItem Content="قيد المتابعة"/><ComboBoxItem Content="تمت الإجابة"/><ComboBoxItem Content="مغلق"/></ComboBox>
                                <CheckBox x:Name="OutgoingFollowBox" Content="متابعة" VerticalAlignment="Center" Margin="10"/>
                                <Button Content="حفظ الصادر" Click="AddOutgoing_Click"/>
                                <Button Content="تعديل" Click="UpdateOutgoing_Click"/>
                                <Button Content="حذف" Click="DeleteOutgoing_Click"/>
                                <Button Content="OCR ملف صادر" Click="OcrOutgoing_Click" ToolTip="يتطلب تثبيت Tesseract وحزمة اللغة العربية"/>
                                <Button Content="إرفاق ملف" Click="AttachOutgoing_Click"/>
                                <Button Content="فتح المرفقات" Click="OpenOutgoingAttachments_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="OutgoingGrid" AutoGeneratingColumn="MainGrid_AutoGeneratingColumn" SelectionChanged="OutgoingGrid_SelectionChanged" MouseDoubleClick="OutgoingGrid_MouseDoubleClick"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="الوارد">
                <DockPanel Margin="8">
                    <Border DockPanel.Dock="Top" Background="White" Padding="10" CornerRadius="10" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="رقم الوارد" VerticalAlignment="Center" Margin="6"/><TextBox x:Name="IncomingNumberBox" Width="140"/><Button Content="رقم تلقائي" Click="GenerateIncomingNumber_Click"/>
                                <TextBlock Text="تاريخ الوارد" VerticalAlignment="Center" Margin="10,6,6,6"/><DatePicker x:Name="IncomingDatePicker" Width="150"/>
                                <TextBlock Text="الجهة" VerticalAlignment="Center" Margin="10,6,6,6"/><ComboBox x:Name="IncomingOrgCombo" Width="280" DisplayMemberPath="Name" SelectedValuePath="Id" IsEditable="True" IsTextSearchEnabled="True"/>
                                <TextBlock Text="المواطن" VerticalAlignment="Center" Margin="10,6,6,6"/><ComboBox x:Name="IncomingCitizenCombo" Width="300" DisplayMemberPath="FullName" SelectedValuePath="Id" TextSearch.TextPath="FullName" IsEditable="True" IsTextSearchEnabled="True" ToolTip="اختر المواطن من الأضبارة الرئيسية أو اكتب اسمه للبحث"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,6"><TextBlock Text="الموضوع" VerticalAlignment="Center" Margin="6"/><TextBox x:Name="IncomingSubjectBox" Width="900"/></WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="الأولوية" VerticalAlignment="Center" Margin="6"/><ComboBox x:Name="IncomingPriorityBox" Width="120" SelectedIndex="0"><ComboBoxItem Content="عادي"/><ComboBoxItem Content="مهم"/><ComboBoxItem Content="عاجل"/></ComboBox>
                                <TextBlock Text="الحالة" VerticalAlignment="Center" Margin="10,6,6,6"/><ComboBox x:Name="IncomingStatusBox" Width="150" SelectedIndex="0"><ComboBoxItem Content="جديد"/><ComboBoxItem Content="قيد المتابعة"/><ComboBoxItem Content="تمت الإجابة"/><ComboBoxItem Content="مغلق"/></ComboBox>
                                <CheckBox x:Name="IncomingFollowBox" Content="متابعة" VerticalAlignment="Center" Margin="10"/>
                                <Button Content="حفظ الوارد" Click="AddIncoming_Click"/>
                                <Button Content="تعديل" Click="UpdateIncoming_Click"/>
                                <Button Content="حذف" Click="DeleteIncoming_Click"/>
                                <Button Content="OCR ملف وارد" Click="OcrIncoming_Click" ToolTip="يتطلب تثبيت Tesseract وحزمة اللغة العربية"/>
                                <Button Content="إرفاق ملف" Click="AttachIncoming_Click"/>
                                <Button Content="فتح المرفقات" Click="OpenIncomingAttachments_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="IncomingGrid" AutoGeneratingColumn="MainGrid_AutoGeneratingColumn" SelectionChanged="IncomingGrid_SelectionChanged" MouseDoubleClick="IncomingGrid_MouseDoubleClick"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="المواطنين">
                <DockPanel Margin="8">
                    <Border DockPanel.Dock="Top" Background="White" Padding="10" CornerRadius="10" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,6"><TextBlock Text="اسم المواطن" VerticalAlignment="Center" Margin="6"/><TextBox x:Name="CitizenNameBox" Width="260"/><TextBlock Text="الهاتف" VerticalAlignment="Center" Margin="10,6,6,6"/><TextBox x:Name="CitizenPhoneBox" Width="160"/><TextBlock Text="العنوان" VerticalAlignment="Center" Margin="10,6,6,6"/><TextBox x:Name="CitizenAddressBox" Width="300"/></WrapPanel>
                            <WrapPanel><TextBlock Text="موضوع الطلب" VerticalAlignment="Center" Margin="6"/><TextBox x:Name="CitizenSubjectBox" Width="560"/><ComboBox x:Name="CitizenStatusBox" Width="150" SelectedIndex="0"><ComboBoxItem Content="جديد"/><ComboBoxItem Content="قيد المتابعة"/><ComboBoxItem Content="منجز"/><ComboBoxItem Content="مغلق"/></ComboBox><CheckBox x:Name="CitizenFollowBox" Content="متابعة" Margin="10" VerticalAlignment="Center"/><Button Content="حفظ المواطن" Click="AddCitizen_Click"/><Button Content="إرفاق ملف للمواطن المحدد" Click="AttachCitizen_Click"/><Button Content="فتح مرفقات المواطن المحدد" Click="OpenCitizenAttachments_Click"/></WrapPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="CitizensGrid"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="المتابعة">
                <DockPanel Margin="8"><Border DockPanel.Dock="Top" Background="White" Padding="10" CornerRadius="10" Margin="0,0,0,8"><WrapPanel><TextBlock Text="النوع" VerticalAlignment="Center" Margin="6"/><ComboBox x:Name="FollowEntityTypeBox" Width="120" SelectedIndex="0"><ComboBoxItem Content="صادر"/><ComboBoxItem Content="وارد"/><ComboBoxItem Content="مواطن"/></ComboBox><TextBlock Text="Id" VerticalAlignment="Center" Margin="10,6,6,6"/><TextBox x:Name="FollowEntityIdBox" Width="100"/><TextBlock Text="الإجراء" VerticalAlignment="Center" Margin="10,6,6,6"/><TextBox x:Name="FollowActionBox" Width="420"/><TextBlock Text="الإجراء القادم" VerticalAlignment="Center" Margin="10,6,6,6"/><DatePicker x:Name="FollowNextDatePicker" Width="150"/><Button Content="حفظ المتابعة" Click="AddFollowup_Click"/></WrapPanel></Border><DataGrid x:Name="FollowupsGrid"/></DockPanel>
            </TabItem>

            <TabItem Header="الربط">
                <StackPanel Margin="16"><TextBlock Text="ربط كتاب صادر بكتاب وارد" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/><WrapPanel><TextBlock Text="الصادر" VerticalAlignment="Center" Margin="6"/><ComboBox x:Name="LinkOutgoingCombo" Width="420" DisplayMemberPath="Title" SelectedValuePath="Id"/><TextBlock Text="الوارد" VerticalAlignment="Center" Margin="10,6,6,6"/><ComboBox x:Name="LinkIncomingCombo" Width="420" DisplayMemberPath="Title" SelectedValuePath="Id"/><Button Content="تنفيذ الربط" Click="LinkLetters_Click"/></WrapPanel></StackPanel>
            </TabItem>

            <TabItem Header="البحث">
                <StackPanel Margin="16"><TextBlock Text="بحث شامل في الصادر والوارد والمواطنين" FontSize="20" FontWeight="Bold"/><WrapPanel Margin="0,8,0,8"><TextBox x:Name="SearchBox" Width="520" ToolTip="رقم الكتاب أو الموضوع أو الجهة أو اسم المواطن"/><Button Content="بحث" Click="Search_Click"/></WrapPanel><DataGrid x:Name="SearchGrid" AutoGeneratingColumn="MainGrid_AutoGeneratingColumn" Height="540"/></StackPanel>
            </TabItem>

            <TabItem Header="التقارير HTML">
                <StackPanel Margin="16"><TextBlock Text="التقارير" FontSize="22" FontWeight="Bold"/><WrapPanel Margin="0,12"><Button Content="تقرير الصادر HTML" Click="ReportOutgoing_Click"/><Button Content="تقرير الوارد HTML" Click="ReportIncoming_Click"/><Button Content="تقرير المواطنين HTML" Click="ReportCitizens_Click"/><Button Content="تقرير شامل HTML" Click="ReportAll_Click"/></WrapPanel><TextBlock x:Name="ReportResultText" Foreground="#065F46" TextWrapping="Wrap"/></StackPanel>
            </TabItem>

            <TabItem Header="النسخ الاحتياطي">
                <StackPanel Margin="16"><TextBlock Text="النسخ الاحتياطي والاستعادة" FontSize="22" FontWeight="Bold"/><Button Content="إنشاء نسخة احتياطية الآن" Width="240" HorizontalAlignment="Right" Click="Backup_Click"/><Button Content="استعادة نسخة احتياطية" Width="240" HorizontalAlignment="Right" Click="RestoreBackup_Click"/><TextBlock x:Name="BackupResultText" TextWrapping="Wrap" Foreground="#065F46" Margin="4,8"/></StackPanel>
            </TabItem>

            <TabItem Header="إدارة المستخدمين">
                <DockPanel Margin="8"><Border DockPanel.Dock="Top" Background="White" Padding="10" CornerRadius="10" Margin="0,0,0,8"><WrapPanel><TextBlock Text="الاسم" VerticalAlignment="Center" Margin="6"/><TextBox x:Name="NewUserFullNameBox" Width="200"/><TextBlock Text="اسم الدخول" VerticalAlignment="Center" Margin="10,6,6,6"/><TextBox x:Name="NewUsernameBox" Width="160"/><TextBlock Text="كلمة المرور" VerticalAlignment="Center" Margin="10,6,6,6"/><PasswordBox x:Name="NewUserPasswordBox" Width="150"/><TextBlock Text="الصلاحية" VerticalAlignment="Center" Margin="10,6,6,6"/><ComboBox x:Name="NewUserRoleBox" Width="130" SelectedIndex="1"><ComboBoxItem Content="مدير"/><ComboBoxItem Content="موظف"/><ComboBoxItem Content="قراءة فقط"/></ComboBox><Button Content="إضافة مستخدم" Click="AddUser_Click"/></WrapPanel></Border><DataGrid x:Name="UsersGrid"/></DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
